PORT=5000
HOST=0.0.0.0
MONGO_URI=mongodb://127.0.0.1:27017/peoplepay360
JWT_SECRET=your_jwt_secret_change_this
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
COMPANY_NAME=PeoplePay360

# Email / SMTP (Gmail App Password recommended)
# Either SMTP_* or MAIL_* aliases are accepted
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PeoplePay360 <your-email@gmail.com>

# Optional aliases (same values):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=your-email@gmail.com
# MAIL_PASSWORD=your-google-app-password
# MAIL_FROM=PeoplePay360 <your-email@gmail.com>
